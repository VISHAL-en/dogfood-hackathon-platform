{
  "name": "dogfood-hackathon-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable hackathon submission and judging platform",
  "main": "dist/backend/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/backend/index.js",
    "lint": "tsc --noEmit && tsc -p src/frontend/tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
